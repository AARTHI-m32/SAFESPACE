# Use Node.js as the base image
FROM node:18

# Set the working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the entire frontend code
COPY . .

# Build the React app
RUN npm run build

# Expose the frontend port
EXPOSE 3000

# Serve the built app
CMD ["npx", "serve", "-s", "build"]
